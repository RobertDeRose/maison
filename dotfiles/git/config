# Static Git configuration. Mise deploys the identity and platform-specific
# fragments included below.
[include]
    path = ~/.config/git/identity
[include]
    path = ~/.config/git/platform
[includeIf "gitdir:~/workspace/personal/"]
    path = ~/workspace/personal/.gitconfig

[core]
    autocrlf = input
    editor = hx
    whitespace = trailing-space,space-before-tab
[credential]
    helper = cache --timeout=3600
[credential "https://github.com"]
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper = !gh auth git-credential
[grep]
    lineNumber = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
[init]
    defaultBranch = main
[merge]
    conflictstyle = zdiff3
[pull]
    rebase = true
    ff = only
[rebase]
    autoStash = true
[push]
    default = current
    autoSetupRemote = true
# Personal signing identity belongs in the private Terroir overlay.
[url "git@github.com:"]
    insteadOf = https://github.com/
[tar "tar.xz"]
    command = xz -c
