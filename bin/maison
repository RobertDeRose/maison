#!/usr/bin/env bash
# shellcheck shell=bash
# Maison is the location-independent command interface to the repository's mise tasks.
#
#USAGE about "Put your workstation in order."
#USAGE long_about "Nix/Lix owns OS-level state; mise owns user tools, applications, preferences, and dotfiles."
#USAGE flag "-V --version" help="Show the installed Maison revision"
#USAGE cmd "apply" help="Apply system and user configuration" { arg "[args]..." }
#USAGE cmd "bootstrap" help="Bootstrap or repair a host" { arg "[args]..." }
#USAGE cmd "check" help="Validate repository contracts" { arg "[args]..." }
#USAGE cmd "deploy" help="Deploy a Linux system and user environment" { arg "[args]..." }
#USAGE cmd "doctor" help="Diagnose both ownership layers" { arg "[args]..." }
#USAGE cmd "plan" help="Preview system and user changes" { arg "[args]..." }
#USAGE cmd "rollback" help="Roll back the Nix system layer" { arg "[args]..." }
#USAGE cmd "update" help="Update Nix inputs and mise-managed software" { arg "[args]..." }
#USAGE cmd "tasks" help="List Maison tasks" { arg "[args]..." }
#USAGE cmd "help" help="Print this message or the help of the given command" { arg "[command]..." }
#USAGE cmd "completion" help="Generate shell completion" {
#USAGE   arg "<shell>" { choices "bash" "zsh" "fish" }
#USAGE }
#USAGE cmd "system" help="Manage OS-level Nix state" {
#USAGE   cmd "plan" help="Build without activation" { arg "[args]..." }
#USAGE   cmd "apply" help="Build and activate" { arg "[args]..." }
#USAGE   cmd "deploy" help="Deploy with deploy-rs" { arg "[args]..." }
#USAGE   cmd "history" help="List system generations" { arg "[args]..." }
#USAGE   cmd "rollback" help="Activate the prior generation" { arg "[args]..." }
#USAGE   cmd "clean" help="Clean old generations" { arg "[args]..." }
#USAGE }
#USAGE cmd "user" help="Manage mise-owned user state" {
#USAGE   cmd "plan" help="Preview bootstrap changes" { arg "[args]..." }
#USAGE   cmd "apply" help="Converge tools, apps, preferences, and dotfiles" { arg "[args]..." }
#USAGE   cmd "status" help="Show drift" { arg "[args]..." }
#USAGE   cmd "update" help="Upgrade tools and packages" { arg "[args]..." }
#USAGE }
#USAGE cmd "host" help="Manage hosts" {
#USAGE   cmd "add" help="Add a host" { arg "[args]..." }
#USAGE   cmd "list" help="List hosts" { arg "[args]..." }
#USAGE   cmd "validate" help="Validate inventory" { arg "[args]..." }
#USAGE }
#USAGE cmd "consumer" help="Validate a consumer repository" {
#USAGE   cmd "validate" help="Validate without activation" { arg "[args]..." }
#USAGE }
#USAGE cmd "self" help="Manage the Maison framework" {
#USAGE   cmd "update" help="Upgrade Maison from the consumer lock" { arg "[args]..." }
#USAGE }
#USAGE cmd "tool" help="Manage global mise tools" {
#USAGE   cmd "add" help="Add a tool" { arg "[args]..." }
#USAGE   cmd "remove" help="Remove a tool" { arg "[args]..." }
#USAGE }
#USAGE cmd "package" help="Manage mise bootstrap packages" {
#USAGE   cmd "add" help="Add a package" { arg "[args]..." }
#USAGE   cmd "remove" help="Remove a package" { arg "[args]..." }
#USAGE   cmd "search" help="Search package sources" { arg "[args]..." }
#USAGE   cmd "update" help="Upgrade Homebrew formulae" { arg "[args]..." }
#USAGE }
#USAGE cmd "app" help="Manage macOS applications" {
#USAGE   cmd "add" help="Add a cask" { arg "[args]..." }
#USAGE   cmd "remove" help="Remove a cask" { arg "[args]..." }
#USAGE   cmd "update" help="Upgrade casks and Mac App Store apps" { arg "[args]..." }
#USAGE }
#USAGE cmd "docs" help="Manage documentation" {
#USAGE   cmd "build" help="Build documentation" { arg "[args]..." }
#USAGE   cmd "check" help="Validate documentation structure" { arg "[args]..." }
#USAGE   cmd "deployment" help="Manage documentation deployment" {
#USAGE     cmd "enable" help="Enable GitHub Pages deployment" { arg "[args]..." }
#USAGE   }
#USAGE   cmd "serve" help="Serve documentation" { arg "[args]..." }
#USAGE }
#USAGE cmd "github" help="Manage GitHub authentication" {
#USAGE   cmd "auth" help="Configure GitHub API authentication" { arg "[args]..." }
#USAGE }
#USAGE cmd "activate" hide=#true { arg "[args]..." }
#USAGE cmd "__task-names" hide=#true
#USAGE cmd "__command-paths" hide=#true

set -euo pipefail

# A successful `maison self update` stores the candidate package executable in
# owner-only state. Explicit MAISON_HOME remains authoritative for development
# and recovery, while ordinary invocations follow the persisted CLI revision.
if [ -z "${MAISON_HOME:-}" ] && [ "${MAISON_CLI_STATE_ACTIVE:-false}" != true ]; then
  maison_cli_state_file="${MAISON_CLI_STATE_FILE:-${XDG_STATE_HOME:-${HOME:-$PWD}/.local/state}/maison/cli}"
  if [ -f "$maison_cli_state_file" ] && [ ! -L "$maison_cli_state_file" ]; then
    IFS= read -r maison_persisted_cli < "$maison_cli_state_file" || maison_persisted_cli=""
    case "$maison_persisted_cli" in
      /*)
        if [ -x "$maison_persisted_cli" ]; then
          export MAISON_CLI_STATE_ACTIVE=true
          exec "$maison_persisted_cli" "$@"
        fi
        ;;
    esac
  fi
fi

log_error() {
  printf 'maison: %s\n' "$*" >&2
}

die() {
  log_error "$*"
  exit 1
}

resolve_script_maison_home() {
  local script_path="${BASH_SOURCE[0]}" script_dir link_target

  while [ -L "$script_path" ]; do
    script_dir="$(cd -P "$(dirname "$script_path")" > /dev/null 2>&1 && pwd)"
    link_target="$(readlink "$script_path")"
    case "$link_target" in
      /*) script_path="$link_target" ;;
      *) script_path="$script_dir/$link_target" ;;
    esac
  done

  script_dir="$(cd -P "$(dirname "$script_path")" > /dev/null 2>&1 && pwd)"
  cd "$script_dir/.." > /dev/null 2>&1 && pwd
}

script_maison_home="$(resolve_script_maison_home || true)"
if [ -n "${MAISON_HOME:-}" ]; then
  maison_home="$MAISON_HOME"
elif [ -n "${NIX_CONFIG_DIR:-}" ]; then
  maison_home="$NIX_CONFIG_DIR"
elif [ -f "$script_maison_home/mise.toml" ] && [ -f "$script_maison_home/flake.nix" ]; then
  maison_home="$script_maison_home"
else
  maison_home="$HOME/.maison"
fi

if [ ! -d "$maison_home" ]; then
  die "installation not found at $maison_home; set MAISON_HOME or rerun bootstrap"
fi
if [ ! -f "$maison_home/mise.toml" ] || [ ! -f "$maison_home/flake.nix" ]; then
  die "$maison_home does not look like a Maison installation"
fi

if command -v mise > /dev/null 2>&1; then
  mise_bin="$(command -v mise)"
elif [ -x "$HOME/.local/bin/mise" ]; then
  mise_bin="$HOME/.local/bin/mise"
else
  die "mise is unavailable; rerun Maison bootstrap"
fi

maison_home="$(cd "$maison_home" && pwd -P)"
export MAISON_HOME="$maison_home"

# Maison supplies the executable and task definitions; the current checkout
# supplies the consumer's flake, lock, inventory, and user configuration.
# Never infer the Maison installation itself as the consumer repository.
resolve_consumer_from_pwd() {
  local candidate
  if [ -n "${MAISON_CONSUMER_ROOT:-${MAISON_REPOSITORY:-${MAISON_REPO:-}}}" ]; then
    candidate="${MAISON_CONSUMER_ROOT:-${MAISON_REPOSITORY:-${MAISON_REPO:-}}}"
  elif candidate="$(git -C "$PWD" rev-parse --show-toplevel 2> /dev/null)" &&
    [ "$(cd "$candidate" && pwd -P)" != "$maison_home" ]; then
    :
  else
    return 0
  fi
  candidate="$(cd "$candidate" 2> /dev/null && pwd -P)" ||
    die "consumer repository is unavailable: ${MAISON_CONSUMER_ROOT:-$candidate}"
  export MAISON_CONSUMER_ROOT="$candidate"
}
resolve_consumer_from_pwd

export MISE_PROJECT_ROOT="$maison_home"
export MISE_TRUSTED_CONFIG_PATHS="$maison_home${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"

filesystem_task_names() {
  find "$maison_home/.mise/tasks" -type f -perm -u+x -print \
    | sed "s#^$maison_home/.mise/tasks/##; s#/#:#g" \
    | LC_ALL=C sort -u
}

task_names_cache=""
task_names_cached=false

cache_task_names() {
  local tasks
  [ "$task_names_cached" = true ] && return
  if tasks="$($mise_bin -C "$maison_home" tasks --name-only --hidden 2> /dev/null)" && [ -n "$tasks" ]; then
    task_names_cache="$tasks"
  else
    task_names_cache="$(filesystem_task_names)"
  fi
  task_names_cached=true
}

is_public_task() {
  case "$1" in
    # Repository maintenance remains available through mise, not Maison.
    fix) return 1 ;;
    *) return 0 ;;
  esac
}

list_public_task_names() {
  local task compatibility tasks all_tasks
  cache_task_names
  if tasks="$($mise_bin -C "$maison_home" tasks --name-only 2> /dev/null)" && [ -n "$tasks" ]; then
    all_tasks="$task_names_cache"
  else
    tasks="$task_names_cache"
    all_tasks="$tasks"
  fi
  while IFS= read -r task; do
    [ -n "$task" ] || continue
    is_public_task "$task" || continue
    compatibility="${task//-/:}"
    if [ "$compatibility" != "$task" ] && grep -Fxq "$compatibility" <<<"$all_tasks"; then
      continue
    fi
    printf '%s\n' "$task"
  done <<<"$tasks"
}

list_command_paths() {
  list_public_task_names | tr ':' ' '
}

format_task_groups() {
  awk '
    function task_group(task) {
      if (task ~ /^(apply|bootstrap|deploy|doctor|fix|plan|rollback|update)$/) return "workflow"
      if (task == "github:auth") return "github"
      if (task ~ /^app:(add|remove|update)$/) return "app"
      if (task ~ /^package:(add|remove|search|update)$/) return "package"
      if (task ~ /^tool:(add|remove)$/) return "tool"
      if (task ~ /^host:(add|list)$/) return "host"
      if (task == "consumer:validate") return "consumer"
      if (task == "self:update") return "self"
      if (task ~ /^system:(apply|clean|deploy|history|plan|rollback)$/) return "system"
      if (task ~ /^user:(apply|plan|recover|restore-dotfiles|status|update)$/) return "user"
      if (task == "docs:serve") return "docs"
      return ""
    }

    NF {
      task = $1
      if (task == "fix") next
      group = task_group(task)
      if (group == "") next
      display = task
      if (task == "user:restore-dotfiles") {
        display = "restore"
      }
      sub(/^[^:]*:/, "", display)
      description = $0
      sub(/^[^[:space:]]+[[:space:]]*/, "", description)
      if (group == "workflow") {
        if (description == $0) {
          workflow = workflow "  " display "\n"
        } else if (length(display) >= 16) {
          workflow = workflow "  " display " " description "\n"
        } else {
          workflow = workflow sprintf("  %-16s%s\n", display, description)
        }
      } else if (description == $0) {
        grouped[group] = grouped[group] "  " display "\n"
      } else if (length(display) >= 16) {
        grouped[group] = grouped[group] "  " display " " description "\n"
      } else {
        grouped[group] = grouped[group] sprintf("  %-16s%s\n", display, description)
      }
    }

    END {
      if (workflow != "") {
        printf "%s", workflow
        printed_group = 1
      }
      order_count = split("github app package tool host consumer self system user docs", order)
      for (position = 1; position <= order_count; position++) {
        group = order[position]
        if (group in grouped) {
          if (printed_group) print ""
          printf "%s:\n%s", group, grouped[group]
          printed_group = 1
        }
      }
    }
  '
}

resolve_task() {
  local -a words=("$@")
  local candidate="" best="" index best_count=0 task lookup_candidate

  cache_task_names
  for ((index = 0; index < ${#words[@]}; index++)); do
    if [ -z "$candidate" ]; then
      candidate="${words[index]}"
    else
      candidate+="${candidate:+:}${words[index]}"
    fi

    lookup_candidate="$candidate"
    [ "$lookup_candidate" != "user:restore" ] || lookup_candidate="user:restore-dotfiles"
    while IFS= read -r task; do
      if [ "$lookup_candidate" = "$task" ] && is_public_task "$task"; then
        best="$task"
        best_count=$((index + 1))
        break
      fi
    done <<<"$task_names_cache"
  done

  [ -n "$best" ] || return 1
  printf '%s\t%s\n' "$best" "$best_count"
}

show_task_help() {
  local requested_task="$1"
  case "$requested_task" in
    github:auth)
      exec "$mise_bin" run --skip-tools "$requested_task" --help
      ;;
    tool:add | tool:remove)
      exec env -u usage_tool -u usage_version \
        usage bash "$maison_home/.mise/tasks/${requested_task/:/\/}" --help
      ;;
    bootstrap)
      exec "$mise_bin" exec --locked python -- "$mise_bin" run --skip-tools "$requested_task" --help
      ;;
    *)
      exec "$mise_bin" run "$requested_task" --help
      ;;
  esac
}

show_help() {
  local task_output
  cat <<'HELP'
Maison — Votre maison, parfaitement ordonnée (Your home, perfectly ordered)

A frontend for mise and Nix with a unified interface for managing multiple systems and user state.

Usage:
  maison <command> [subcommand...] [arguments...]
  maison help [command] [subcommand...]
  maison completion <bash|zsh|fish>
  maison --version

Task-specific help:
  maison help package search

Available commands and their subcommands:
HELP
  if task_output="$($mise_bin -C "$maison_home" tasks 2> /dev/null)" && [ -n "$task_output" ]; then
    format_task_groups <<<"$task_output"
  else
    list_public_task_names | format_task_groups
  fi
  cat <<'HELP'

Run `maison tasks` for the complete underlying mise task list.
HELP
}

case "${1:-}" in
  "" | -h | --help)
    show_help
    exit 0
    ;;
  -V | --version)
    if git -C "$maison_home" rev-parse --short HEAD > /dev/null 2>&1; then
      revision="$(git -C "$maison_home" rev-parse --short HEAD)"
    elif [ -s "$maison_home/.maison-revision" ]; then
      revision="$(cut -c1-12 "$maison_home/.maison-revision")"
    elif [ -n "${MAISON_PACKAGE_VERSION:-}" ]; then
      revision="$MAISON_PACKAGE_VERSION"
    else
      revision=unknown
    fi
    printf 'maison %s\n' "$revision"
    exit 0
    ;;
  help)
    shift
    if [ "$#" -eq 0 ]; then
      show_help
      exit 0
    fi
    resolution="$(resolve_task "$@" || true)"
    [ -n "$resolution" ] || die "unknown command '$*'"
    task="${resolution%%$'\t'*}"
    cd "$maison_home"
    show_task_help "$task"
    ;;
  tasks)
    shift
    cd "$maison_home"
    exec "$mise_bin" tasks "$@"
    ;;
  completion)
    [ "$#" -eq 2 ] || die "usage: maison completion <bash|zsh|fish>"
    exec usage generate completion "$2" maison -f "$maison_home/bin/maison"
    ;;
  __task-names)
    list_public_task_names
    exit 0
    ;;
  __command-paths)
    list_command_paths
    exit 0
    ;;
esac

resolution="$(resolve_task "$@" || true)"
[ -n "$resolution" ] || die "unknown command '$*'; run 'maison tasks' to list commands"
task="${resolution%%$'\t'*}"
consumed="${resolution##*$'\t'}"
shift "$consumed"

cd "$maison_home"

# Tool configuration must remain repairable when an invalid entry prevents
# mise from resolving the project configuration at all.
case "$task" in
  tool:add | tool:remove)
    exec env -u usage_tool -u usage_version \
      usage bash "$maison_home/.mise/tasks/${task/:/\/}" "$@"
    ;;
esac

run_task() {
  local output_file status
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_task_help "$task"
  fi
  local -a command=("$mise_bin" run)

  case "$task" in
    github:auth | tool:add | tool:remove) command+=(--skip-tools) ;;
    bootstrap) command=("$mise_bin" exec --locked python -- "$mise_bin" run --skip-tools) ;;
  esac
  command+=("$task" -- "$@")

  output_file="$(mktemp "${TMPDIR:-/tmp}/maison-output.XXXXXX")"

  set +e
  if [ -t 2 ]; then
    # Keep the real terminal attached for nested package operations that may
    # legitimately prompt through sudo. mise's native log file preserves the
    # error text needed for the GitHub-authentication hint without changing
    # the command's terminal semantics.
    MAISON_INTERACTIVE=true MISE_LOG_FILE="$output_file" MISE_LOG_FILE_LEVEL=info "${command[@]}"
  else
    "${command[@]}" > >(tee "$output_file") 2> >(tee -a "$output_file" >&2)
  fi
  status=$?
  set -e

  if grep -Eqi 'rate limit exceeded|API rate limit|HTTP error 403|403 Forbidden|No GitHub token' "$output_file"; then
    printf '\nmaison: GitHub authentication is required or the API rate limit was exceeded.\n' >&2
    printf 'Run: maison github auth\n' >&2
  fi

  rm -f "$output_file"
  return "$status"
}

run_task "$@"
