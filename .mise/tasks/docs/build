#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Build the mdBook documentation with repository tooling"
set -euo pipefail
TASK_FILE="${BASH_SOURCE[0]}"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "$TASK_FILE")" rev-parse --show-toplevel)}"
cd "$REPO_ROOT"

mise install github:rust-lang/mdBook
mise exec -- mdbook build docs
