#!/usr/bin/env bash
# [MISE] description="Preview the Nix system layer, then the mise user layer"
#USAGE flag "--host <host>" help="Inventory host"
#USAGE flag "--force-dotfiles" help="Preview replacement of conflicting user dotfiles"
set -euo pipefail
args=()
[ -z "${usage_host:-}" ] || args+=(--host "$usage_host")
mise run system:plan -- "${args[@]}"
args=()
[ "${usage_force_dotfiles:-false}" != true ] || args+=(--force-dotfiles)
mise run user:plan -- "${args[@]}"
