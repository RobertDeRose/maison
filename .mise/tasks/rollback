#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Roll back only the Nix system layer"
# [MISE] interactive=true
#USAGE flag "-y --yes" help="Skip confirmation"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
args=()
[ "${usage_yes:-false}" != true ] || args+=(--yes)
exec mise -C "$framework_root" run system:rollback -- "${args[@]}"
