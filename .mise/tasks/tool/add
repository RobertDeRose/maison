#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Install a global mise tool, then atomically commit config and lock changes"
#USAGE arg "<tool>" help="Backend-qualified tool name"
#USAGE arg "[version]" default="latest" help="Version"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
source "$framework_root/.mise/lib/transaction.sh"
source "$framework_root/.mise/lib/repository_git.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
repository_require_authoring "$root" tool:add
config_root="$root"
export MAISON_USER_CONFIG_ROOT="$config_root"
export MISE_GLOBAL_CONFIG_FILE="$config_root/config/mise/config.toml"
version="${usage_version:-latest}"
config="$config_root/config/mise/config.toml"
lock="$config_root/config/mise/mise.lock"
tool="${usage_tool:?mise did not provide the required tool argument}"
transaction_require_authoring_checkout "$config_root" tool:add
transaction_require_lock "$config_root" "${BASH_SOURCE[0]}" "$@"
repository_refresh "$framework_root" "$config_root" tool:add
repository_require_clean "$framework_root" "$config_root" tool:add "$config" "$lock"
transaction_dir="$(transaction_directory)"
original_config="$transaction_dir/config.original.toml"
original_lock="$transaction_dir/mise.original.lock"
candidate_config="$transaction_dir/config.toml"
candidate_lock="$transaction_dir/mise.lock"
cp -p "$config" "$original_config"
cp -p "$config" "$candidate_config"
lock_existed=false
if [ -e "$lock" ]; then
  cp -p "$lock" "$original_lock"
  cp -p "$lock" "$candidate_lock"
  lock_existed=true
else
  : >"$candidate_lock"
fi
config_attempted=false
lock_attempted=false
success=false

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [ "$success" != true ]; then
    rollback_status=0
    if [ "$config_attempted" = true ]; then
      transaction_restore_file "$original_config" "$config" || rollback_status=$?
    fi
    if [ "$lock_attempted" = true ]; then
      if [ "$lock_existed" = true ]; then
        transaction_restore_file "$original_lock" "$lock" || rollback_status=$?
      else
        rm -f "$lock" || rollback_status=$?
      fi
    fi
    if [ "${MAISON_REPOSITORY_MUTATION_JOURNAL:-}" ]; then
      if [ "$rollback_status" -eq 0 ]; then
        transaction_journal_complete || rollback_status=$?
      else
        printf 'tool:add: rollback failed; preserved mutation journal at %s\n' \
          "$MAISON_REPOSITORY_MUTATION_JOURNAL" >&2
      fi
    fi
    [ "$rollback_status" -eq 0 ] || status="$rollback_status"
  fi
  rm -rf "$transaction_dir"
  exit "$status"
}
trap cleanup EXIT
transaction_set_signal_traps

python3 "$framework_root/.mise/lib/config_edit.py" tool \
  --file "$candidate_config" \
  --name "$tool" \
  --version "$version"

suffix="${tool##*@}"
if [[ "$tool" == *@* && "$suffix" != */* ]]; then
  install_spec="$tool"
else
  install_spec="${tool}@${version}"
fi

set +e
install_output="$(MISE_AUTO_ENV=false MISE_GLOBAL_CONFIG_FILE="$candidate_config" mise install "$install_spec" 2>&1)"
install_status=$?
set -e
printf '%s\n' "$install_output"
if [ "$install_status" -ne 0 ] ||
  grep -Eq 'mise ERROR|Failed to resolve tool version list' <<<"$install_output"; then
  printf 'tool:add: installation failed; consumer config and lock were not changed\n' >&2
  exit 1
fi

python3 "$framework_root/.mise/lib/config_edit.py" validate "$candidate_config" "$candidate_lock"
transaction_journal_begin "$config_root" tool:add "$config" "$lock"
transaction_journal_mark validated
lock_attempted=true
atomic_replace "$candidate_lock" "$lock"
config_attempted=true
atomic_replace "$candidate_config" "$config"
success=true
transaction_journal_complete
if ! repository_commit "$framework_root" "$config_root" added tool "$install_spec" "$config" "$lock"; then
  exit 1
fi
printf 'Installed and added %s to %s.\n' "$install_spec" "${config#"$config_root"/}"
