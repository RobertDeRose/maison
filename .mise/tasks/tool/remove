#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Remove a global mise tool, then atomically commit config and lock changes"
#USAGE arg "<tool>" help="Tool name, optionally name@version"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
source "$framework_root/.mise/lib/transaction.sh"
source "$framework_root/.mise/lib/git.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
git_require_authoring "$root" tool:remove
config_root="$root"
export MAISON_CONSUMER_ROOT="$config_root"
export MISE_GLOBAL_CONFIG_FILE="$config_root/config/mise/config.toml"
config="$config_root/config/mise/config.toml"
lock="$config_root/config/mise/mise.lock"
tool="${usage_tool:?mise did not provide the required tool argument}"
transaction_require_authoring_checkout "$config_root" tool:remove
protected_tool="$tool"
protected_suffix="${tool##*@}"
if [[ "$tool" == *@* && "$protected_suffix" != */* ]]; then
  protected_tool="${tool%@*}"
fi
[ "$protected_tool" != usage ] || {
  printf 'error: usage is the Maison command runtime and cannot be removed\n' >&2
  exit 2
}
transaction_require_lock "$config_root" "${BASH_SOURCE[0]}" "$@"
git_require_clean_paths "$config_root" tool:remove "$config" "$lock"
transaction_dir="$(transaction_directory)"
original_config="$transaction_dir/config.original.toml"
original_lock="$transaction_dir/mise.original.lock"
candidate_config="$transaction_dir/config.toml"
candidate_lock="$transaction_dir/mise.lock"
cp -p "$config" "$original_config"
cp -p "$config" "$candidate_config"
cp -p "$lock" "$original_lock"
cp -p "$lock" "$candidate_lock"
config_attempted=false
lock_attempted=false
success=false

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [ "$success" != true ]; then
    rollback_status=0
    if [ "$config_attempted" = true ]; then
      transaction_restore_file "$original_config" "$config" || rollback_status=$?
    fi
    if [ "$lock_attempted" = true ]; then
      transaction_restore_file "$original_lock" "$lock" || rollback_status=$?
    fi
    if [ "${MAISON_REPOSITORY_MUTATION_JOURNAL:-}" ]; then
      if [ "$rollback_status" -eq 0 ]; then
        transaction_journal_complete || rollback_status=$?
      else
        printf 'tool:remove: rollback failed; preserved mutation journal at %s\n' \
          "$MAISON_REPOSITORY_MUTATION_JOURNAL" >&2
      fi
    fi
    [ "$rollback_status" -eq 0 ] || status="$rollback_status"
  fi
  rm -rf "$transaction_dir"
  exit "$status"
}
trap cleanup EXIT
transaction_set_signal_traps

python3 "$framework_root/.mise/lib/config_edit.py" tool --file "$candidate_config" --name "$tool" --remove
if python3 "$framework_root/.mise/lib/config_edit.py" has-tool --file "$candidate_config" --name "$tool"; then
  tool_name="$tool"
  suffix="${tool##*@}"
  if [[ "$tool" == *@* && "$suffix" != */* ]]; then
    tool_name="${tool%@*}"
  fi
  MISE_AUTO_ENV=false MISE_GLOBAL_CONFIG_FILE="$candidate_config" mise lock --global "$tool_name"
else
  python3 "$framework_root/.mise/lib/config_edit.py" lock-remove \
    --file "$candidate_lock" --config "$candidate_config" --name "$tool"
fi
python3 "$framework_root/.mise/lib/config_edit.py" validate "$candidate_config" "$candidate_lock"
transaction_journal_begin "$config_root" tool:remove "$config" "$lock"
transaction_journal_mark validated
lock_attempted=true
atomic_replace "$candidate_lock" "$lock"
config_attempted=true
atomic_replace "$candidate_config" "$config"
success=true
transaction_journal_complete
if ! git_commit_paths "$config_root" removed tool "$tool" "$config" "$lock"; then
  exit 1
fi
printf 'Removed %s from %s and its generated lock entries. Installed versions were intentionally left in the mise cache.\n' \
  "$tool" "${config#"$config_root"/}"
