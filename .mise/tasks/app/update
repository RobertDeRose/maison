#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Upgrade configured macOS applications"
# [MISE] interactive=true
set -euo pipefail
[ "$(uname -s)" = Darwin ] || {
  printf 'Application updates are only supported on macOS.\n'
  exit 0
}
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
source "$framework_root/.mise/lib/consumer.sh"
load_maison_consumer_environment "$root"
config="$root/config/mise/config.toml"
(
  cd "$HOME"
  MISE_AUTO_ENV=true MISE_GLOBAL_CONFIG_FILE="$config" \
    mise bootstrap packages upgrade --manager brew-cask --yes
  MISE_AUTO_ENV=true MISE_GLOBAL_CONFIG_FILE="$config" \
    mise bootstrap packages upgrade --manager mas --yes
)
