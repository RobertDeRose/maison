#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Atomically remove a macOS cask declaration"
#USAGE arg "<cask>" help="Cask token"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
source "$framework_root/.mise/lib/transaction.sh"
source "$framework_root/.mise/lib/git.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
git_require_authoring "$root" app:remove
config_root="$root"
export MAISON_CONSUMER_ROOT="$config_root"
export MISE_GLOBAL_CONFIG_FILE="$config_root/config/mise/config.toml"
path="$config_root/config/mise/config.macos-arm64.toml"
cask="${usage_cask:?mise did not provide the required cask argument}"
package="brew-cask:$cask"
transaction_require_authoring_checkout "$config_root" app:remove
transaction_require_lock "$config_root" "${BASH_SOURCE[0]}" "$@"
git_require_clean_paths "$config_root" app:remove "$path"
transaction_dir="$(transaction_directory)"
cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  rm -rf "$transaction_dir"
  exit "$status"
}
trap cleanup EXIT
transaction_set_signal_traps
candidate="$(transaction_candidate "$path" "$transaction_dir")"
python3 "$framework_root/.mise/lib/config_edit.py" package --file "$candidate" --name "$package" --remove
python3 "$framework_root/.mise/lib/config_edit.py" validate "$candidate"
transaction_journal_begin "$config_root" app:remove "$path"
transaction_journal_mark validated
atomic_replace "$candidate" "$path"
transaction_journal_complete
if ! git_commit_paths "$config_root" removed app "$cask" "$path"; then
  exit 1
fi
printf 'Removed %s from the macOS config. The installed application was intentionally left in place.\n' "$package"
