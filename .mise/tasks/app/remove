#!/usr/bin/env bash
# [MISE] description="Atomically remove a macOS cask declaration"
#USAGE arg "<cask>" help="Cask token"
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
source "$root/.mise/lib/transaction.sh"
path="$root/config/mise/config.macos-arm64.toml"
package="brew-cask:${usage_cask:?mise did not provide the required cask argument}"
transaction_require_authoring_checkout "$root" app:remove
transaction_require_lock "$root" "${BASH_SOURCE[0]}" "$@"
transaction_dir="$(transaction_directory)"
cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  rm -rf "$transaction_dir"
  exit "$status"
}
trap cleanup EXIT
transaction_set_signal_traps
candidate="$(transaction_candidate "$path" "$transaction_dir")"
python3 "$root/.mise/lib/config_edit.py" package --file "$candidate" --name "$package" --remove
python3 "$root/.mise/lib/config_edit.py" validate "$candidate"
transaction_journal_begin "$root" app:remove "$path"
transaction_journal_mark validated
atomic_replace "$candidate" "$path"
transaction_journal_complete
printf 'Removed %s from the macOS config. The installed application was intentionally left in place.\n' "$package"
