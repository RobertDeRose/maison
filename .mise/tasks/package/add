#!/usr/bin/env bash
# [MISE] description="Install a package, then atomically record its declaration"
#USAGE arg "<package>" help="manager:package"
#USAGE flag "--macos" help="Write to the Apple Silicon macOS user config"
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
source "$root/.mise/lib/transaction.sh"
source "$root/.mise/lib/overlay.sh"
source "$root/.mise/lib/overlay_git.sh"
load_maison_overlay_environment "$root"
maison_overlay_require_active "$root" package:add
config_root="$MAISON_PRIVATE_OVERLAY_PATH"
export MAISON_USER_CONFIG_ROOT="$config_root"
export MISE_GLOBAL_CONFIG_FILE="$config_root/config/mise/config.toml"
path="$config_root/config/mise/config.toml"
[ "${usage_macos:-false}" != true ] || path="$config_root/config/mise/config.macos-arm64.toml"
package="${usage_package:?mise did not provide the required package argument}"
transaction_require_authoring_checkout "$config_root" package:add
transaction_require_lock "$config_root" "${BASH_SOURCE[0]}" "$@"
maison_overlay_refresh "$root" "$config_root" package:add
maison_overlay_require_clean "$root" "$config_root" package:add "$path"
transaction_dir="$(transaction_directory)"
cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  rm -rf "$transaction_dir"
  exit "$status"
}
trap cleanup EXIT
transaction_set_signal_traps
candidate="$(transaction_candidate "$path" "$transaction_dir")"
python3 "$root/.mise/lib/config_edit.py" package --file "$candidate" --name "$package"
python3 "$root/.mise/lib/config_edit.py" validate "$candidate"
"$root/scripts/user-apply-packages.sh" "$package"
transaction_journal_begin "$config_root" package:add "$path"
transaction_journal_mark validated
atomic_replace "$candidate" "$path"
transaction_journal_complete
if ! maison_overlay_commit "$root" "$config_root" added package "$package" "$path"; then
  exit 1
fi
printf 'Installed and added %s to %s.\n' "$package" "${path#"$config_root"/}"
