#!/usr/bin/env bash
# [MISE] description="Upgrade configured Homebrew formulae"
# [MISE] interactive=true
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
config="$HOME/.config/mise/config.toml"
[ -f "$config" ] || config="$root/config/mise/config.toml"
(
  cd "$HOME"
  MISE_AUTO_ENV=true MISE_GLOBAL_CONFIG_FILE="$config" \
    mise bootstrap packages upgrade --manager brew --yes
)
