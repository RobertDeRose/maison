#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="List configured hosts and their profiles"

set -euo pipefail
TASK_FILE="${BASH_SOURCE[0]}"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "$TASK_FILE")" rev-parse --show-toplevel)}"
cd "$REPO_ROOT"
source "$REPO_ROOT/.mise/lib/inventory.sh"

printf '%-24s %-18s %-16s %s\n' HOST SYSTEM USER PROFILES
inventory_host_rows "$REPO_ROOT" | while IFS=$'\t' read -r host system user profiles; do
  printf '%-24s %-18s %-16s %s\n' "$host" "$system" "$user" "$profiles"
done
