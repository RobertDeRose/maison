#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Add a host only after a candidate inventory validates"
#USAGE arg "<hostname>" help="Hostname to add"
#USAGE flag "--system <system>" help="Nix system, for example aarch64-linux"
#USAGE flag "--user <user>" help="Existing inventory user"
#USAGE flag "--profiles <profiles>" help="Comma-separated profiles"
#USAGE flag "--overrides" help="Create a host-specific system.nix stub"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
source "$framework_root/.mise/lib/platform.sh"
source "$framework_root/.mise/lib/inventory.sh"
source "$framework_root/.mise/lib/transaction.sh"
source "$framework_root/.mise/lib/git.sh"
git_require_authoring "$root" host:add
cd "$root"

host="${usage_hostname:?mise did not provide the required hostname argument}"
system="${usage_system:-$(current_system)}"
user="${usage_user:-$(current_user)}"
validate_hostname "$host" || die "invalid hostname: $host"
is_supported_system "$system" || die "unsupported system: $system"
inventory="$(inventory_path "$root")"
inventory_root="$(dirname "$inventory")"
transaction_require_authoring_checkout "$inventory_root" host:add
transaction_require_lock "$inventory_root" "${BASH_SOURCE[0]}" "$@"
inventory_has_host "$root" "$host" && die "host already exists: $host"
inventory_has_user "$root" "$user" || die "inventory user does not exist: $user"
inventory_user_allowed_for_system "$root" "$user" "$system" ||
  die "inventory user '$user' is not valid for '$system'"

profiles="${usage_profiles:-}"
if [ -z "$profiles" ]; then
  case "$system" in
    *-darwin) profiles=base,dev,mac ;;
    *-linux) profiles=base,dev,linux ;;
  esac
fi

normalized_profiles=""
IFS=',' read -r -a values <<<"$profiles"
for profile in "${values[@]}"; do
  profile="$(printf '%s' "$profile" | xargs)"
  case "$profile:$system" in
    base:* | dev:* | mac:*-darwin | linux:*-linux) ;;
    *) die "incompatible or unknown profile: $profile" ;;
  esac
  [ -z "$normalized_profiles" ] || normalized_profiles+=","
  normalized_profiles+="$profile"
done
[ -n "$normalized_profiles" ] || die "at least one profile is required"

override="$inventory_root/hosts/$host"
[ "${usage_overrides:-false}" != true ] || [ ! -e "$override" ] ||
  die "host override path already exists: $override"

transaction_dir="$(transaction_directory)"
original="$transaction_dir/inventory.original.toml"
candidate="$transaction_dir/inventory.toml"
cp -p "$inventory" "$original"
cp -p "$inventory" "$candidate"
staged_override="$transaction_dir/host-override"
inventory_committed=false
override_committed=false
success=false

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [ "$success" != true ]; then
    rollback_status=0
    if [ "$override_committed" = true ]; then
      rm -rf "$override" || rollback_status=$?
    fi
    if [ "$inventory_committed" = true ]; then
      transaction_restore_file "$original" "$inventory" || rollback_status=$?
    fi
    if [ "${MAISON_REPOSITORY_MUTATION_JOURNAL:-}" ]; then
      if [ "$rollback_status" -eq 0 ]; then
        transaction_journal_complete || rollback_status=$?
      else
        printf 'host:add: rollback failed; preserved mutation journal at %s\n' \
          "$MAISON_REPOSITORY_MUTATION_JOURNAL" >&2
      fi
    fi
    [ "$rollback_status" -eq 0 ] || status="$rollback_status"
  fi
  rm -rf "$transaction_dir"
  exit "$status"
}
trap cleanup EXIT
transaction_set_signal_traps

python3 "$framework_root/.mise/lib/config_edit.py" host \
  --file "$candidate" \
  --name "$host" \
  --system "$system" \
  --user "$user" \
  --profiles "$normalized_profiles"

if [ "${usage_overrides:-false}" = true ]; then
  mkdir -p "$staged_override"
  cat >"$staged_override/system.nix" <<'NIX'
{ ... }:
{
  # Host-specific OS-level exceptions only.
}
NIX
fi

python3 "$framework_root/.mise/lib/inventory.py" \
  --file "$candidate" \
  --repo-root "$inventory_root" \
  validate >/dev/null

transaction_journal_begin "$inventory_root" host:add "$inventory" "$override"
transaction_journal_mark validated
trap '' HUP INT TERM
atomic_replace "$candidate" "$inventory"
inventory_committed=true
transaction_set_signal_traps
if [ "${usage_overrides:-false}" = true ]; then
  mkdir -p "$inventory_root/hosts"
  # mkdir is the portable no-clobber operation for directories on both macOS
  # and Linux. Do not let a concurrent destination be treated as mv's parent.
  trap '' HUP INT TERM
  mkdir "$override"
  override_committed=true
  transaction_set_signal_traps
  cp -p "$staged_override/system.nix" "$override/system.nix"
fi

success=true
transaction_journal_complete
printf 'Added host %s after validating the complete candidate inventory.\n' "$host"
if [ "$inventory_root" = "$root" ]; then
  git --no-pager diff -- inventory.toml "hosts/$host" 2> /dev/null || true
else
  git -C "$inventory_root" --no-pager diff -- inventory.toml "hosts/$host" 2> /dev/null || true
fi
