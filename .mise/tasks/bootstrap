#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Install/repair Nix, apply the consumer system, and converge user state"
# [MISE] interactive=true
#USAGE flag "--host <host>" help="Consumer inventory host (defaults to current hostname)"
#USAGE flag "--consumer <path>" help="Consumer repository containing flake.nix, flake.lock, and inventory.toml"
#USAGE flag "--user-only" help="Do not install or apply Nix"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
if [ -n "${usage_consumer:-}" ]; then
  export MAISON_CONSUMER_ROOT="$usage_consumer"
fi
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
# shellcheck source=.mise/lib/fnox.sh
source "$framework_root/.mise/lib/fnox.sh"
maison_fnox_preflight "$root"
cd "$root"
source "$framework_root/.mise/lib/platform.sh"
source "$framework_root/.mise/lib/bootstrap.sh"
host="${usage_host:-$(current_hostname)}"
if [ "${usage_user_only:-false}" != true ]; then
  install_nix_or_lix_if_missing
  mise -C "$framework_root" run system:apply -- --host "$host"
fi
mise -C "$framework_root" run user:apply
