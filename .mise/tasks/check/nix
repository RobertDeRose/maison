#!/usr/bin/env bash
# [MISE] description="Validate and format-check every supported Nix output without warnings"
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
cd "$root"
source "$root/.mise/lib/common.sh"
source "$root/.mise/lib/nix.sh"
load_nix_environment
configure_github_access_token
export NIX_SUPPRESS_DIRTY_WARNING=true

run_nix_checked() {
  local stdout_file stderr_file warning_file status
  stdout_file="$(mktemp)"
  stderr_file="$(mktemp)"
  warning_file="$(mktemp)"

  if nix_command "$@" >"$stdout_file" 2>"$stderr_file"; then
    status=0
  else
    status=$?
  fi

  [ ! -s "$stderr_file" ] || cat "$stderr_file" >&2
  cat "$stdout_file"

  if [ "$status" -eq 0 ]; then
    # A successful Nix command may report transient binary-cache retries as
    # warnings. Those are transport diagnostics, not configuration warnings.
    # Overlay input overrides intentionally produce a lock-file-difference warning;
    # the override is per invocation and must not rewrite the repository lock.
    grep -E '(^|[[:space:]])warning:' "$stderr_file" \
      | grep -Ev 'warning: error: unable to download .*retrying|warning: not writing modified lock file of flake' \
      >"$warning_file" || true

    if [ -s "$warning_file" ]; then
      printf 'Nix emitted warnings while running:' >&2
      printf ' %q' "$@" >&2
      printf '\n' >&2
      status=1
    fi
  fi

  rm -f "$stdout_file" "$stderr_file" "$warning_file"
  return "$status"
}

run_nix_checked flake metadata --no-update-lock-file >/dev/null

run_nix_checked eval --no-update-lock-file --json .#packages \
  --apply 'builtins.mapAttrs (_: packages: builtins.mapAttrs (_: package: package.drvPath) packages)' \
  >/dev/null
run_nix_checked eval --no-update-lock-file --json .#apps \
  --apply '
    builtins.mapAttrs (_: apps:
      builtins.mapAttrs (_: app:
        assert app.type == "app";
        assert builtins.isString app.program;
        app.program
      ) apps
    )
  ' \
  >/dev/null
run_nix_checked eval --no-update-lock-file --json .#formatter \
  --apply 'builtins.mapAttrs (_: formatter: formatter.drvPath)' \
  >/dev/null
run_nix_checked eval --no-update-lock-file --json .#checks \
  --apply 'builtins.mapAttrs (_: checks: builtins.mapAttrs (_: check: check.drvPath) checks)' \
  >/dev/null
run_nix_checked eval --no-update-lock-file --json .#darwinConfigurations \
  --apply 'builtins.mapAttrs (_: configuration: configuration.system.drvPath)' \
  >/dev/null
run_nix_checked eval --no-update-lock-file --json .#systemConfigs \
  --apply 'builtins.mapAttrs (_: configuration: configuration.drvPath)' \
  >/dev/null
run_nix_checked eval --no-update-lock-file --json .#deploy >/dev/null

current_system="$(run_nix_checked eval --impure --raw --expr builtins.currentSystem)"
while IFS= read -r check_name; do
  [ -n "$check_name" ] || continue
  run_nix_checked build --no-update-lock-file --no-link ".#checks.\"$current_system\".\"$check_name\"" >/dev/null
done < <(
  run_nix_checked eval --no-update-lock-file --json ".#checks.\"$current_system\"" --apply builtins.attrNames \
    | python3 -c 'import json, sys; print("\n".join(json.load(sys.stdin)))'
)

run_nix_checked fmt --no-update-lock-file -- --ci
