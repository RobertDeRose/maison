#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Validate and format-check every supported Nix output without warnings"
set -euo pipefail
root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
cd "$root"
source "$root/.mise/lib/common.sh"
source "$root/.mise/lib/nix.sh"
load_nix_environment
configure_github_access_token "$root"
export NIX_SUPPRESS_DIRTY_WARNING=true

run_nix_checked() {
  local stdout_file stderr_file warning_file status
  stdout_file="$(mktemp)"
  stderr_file="$(mktemp)"
  warning_file="$(mktemp)"

  if nix_command "$@" >"$stdout_file" 2>"$stderr_file"; then
    status=0
  else
    status=$?
  fi

  [ ! -s "$stderr_file" ] || cat "$stderr_file" >&2
  cat "$stdout_file"

  if [ "$status" -eq 0 ]; then
    # A successful Nix command may report transient binary-cache retries as
    # warnings. Those are transport diagnostics, not configuration warnings.
    grep -E '(^|[[:space:]])warning:' "$stderr_file" \
      | grep -Ev 'warning: error: unable to download .*retrying|warning: not writing modified lock file of flake' \
      >"$warning_file" || true

    if [ -s "$warning_file" ]; then
      printf 'Nix emitted warnings while running:' >&2
      printf ' %q' "$@" >&2
      printf '\n' >&2
      status=1
    fi
  fi

  rm -f "$stdout_file" "$stderr_file" "$warning_file"
  return "$status"
}

run_nix_checked flake metadata --no-update-lock-file >/dev/null

BATCH_NIX_EVAL="$(cat <<'NIX'
let
  source = builtins.getFlake (toString ./.);
  # builtins.getFlake exposes locked inputs separately from the complete flake
  # output argument set; flake-parts needs the latter's self input as well.
  inputs = source.inputs // { self = source; };
  inventoryFile = "${toString ./inventory.toml}";
  inventory = builtins.fromTOML (builtins.readFile inventoryFile);
  outputs = import ./nix/outputs.nix { inherit inputs inventoryFile inventory; };
  packages = builtins.mapAttrs (_: packages: builtins.mapAttrs (_: package: package.drvPath) packages) outputs.packages;
  apps = builtins.mapAttrs (_: apps:
    builtins.mapAttrs (_: app:
      assert app.type == "app";
      assert builtins.isString app.program;
      app.program
    ) apps
  ) outputs.apps;
  formatter = builtins.mapAttrs (_: formatter: formatter.drvPath) outputs.formatter;
  checks = builtins.mapAttrs (_: checks: builtins.mapAttrs (_: check: check.drvPath) checks) outputs.checks;
  darwinConfigurations = builtins.mapAttrs (_: configuration: configuration.system.drvPath) outputs.darwinConfigurations;
  systemConfigs = builtins.mapAttrs (_: configuration: configuration.drvPath) outputs.systemConfigs;
in {
  inherit packages apps formatter checks darwinConfigurations systemConfigs;
  deploy = outputs.deploy;
}
NIX
)"

batch_json_file="$(mktemp)"
trap 'rm -f "$batch_json_file"' EXIT
run_nix_checked eval --impure --no-update-lock-file --json --expr "$BATCH_NIX_EVAL" >"$batch_json_file"

current_system="$(run_nix_checked eval --impure --raw --expr builtins.currentSystem)"
check_installables=()
check_names="$(python3 -c '
import json
import sys

checks = json.load(sys.stdin)["checks"].get(sys.argv[1])
if checks is None:
    raise SystemExit(f"missing Nix checks for {sys.argv[1]}")
print("\n".join(checks))
' "$current_system" <"$batch_json_file")"
while IFS= read -r check_name; do
  [ -n "$check_name" ] || continue
  check_installables+=(".#checks.\"$current_system\".\"$check_name\"")
done <<<"$check_names"
if [ "${#check_installables[@]}" -gt 0 ]; then
  run_nix_checked build --no-update-lock-file --no-link "${check_installables[@]}" >/dev/null
fi

run_nix_checked fmt --no-update-lock-file -- --ci
