#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Pull the consumer repository, then apply its configuration"
# [MISE] interactive=true
#USAGE flag "--host <host>" help="Inventory host"
#USAGE flag "--system-only" help="Skip the mise user layer"
#USAGE flag "--user-only" help="Skip the Nix system layer"
#USAGE flag "--force-dotfiles" help="Replace conflicting user dotfiles"
set -euo pipefail

framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
source "$framework_root/.mise/lib/repository_git.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
repository_require_authoring "$root" sync
# shellcheck source=.mise/lib/fnox.sh
source "$framework_root/.mise/lib/fnox.sh"
maison_fnox_preflight "$root"

if ! git -C "$root" rev-parse --show-toplevel > /dev/null 2>&1; then
  die "consumer repository is not a Git checkout: $root"
fi
log_info "Pulling consumer repository: $root"
git -C "$root" pull --ff-only --autostash

apply_args=()
[ -z "${usage_host:-}" ] || apply_args+=(--host "$usage_host")
[ "${usage_system_only:-false}" != true ] || apply_args+=(--system-only)
[ "${usage_user_only:-false}" != true ] || apply_args+=(--user-only)
[ "${usage_force_dotfiles:-false}" != true ] || apply_args+=(--force-dotfiles)
unset MAISON_FNOX_PREFLIGHT_DONE
mise -C "$framework_root" run apply -- "${apply_args[@]}"
