#!/usr/bin/env bash
# [MISE] description="Build the pinned Maison Apple Container Linux image"
#MISE hide=true
# [MISE] quiet=true
set -euo pipefail

framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
# shellcheck source=.mise/lib/consumer-integration.sh
source "$framework_root/.mise/lib/consumer-integration.sh"
command -v container >/dev/null 2>&1 || {
  printf 'error: Linux integration image requires the Apple container command\n' >&2
  exit 1
}
consumer_integration_build_image "$framework_root"
