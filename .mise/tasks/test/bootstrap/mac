#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Run macOS bootstrap validation in a disposable Lume VM"
# [MISE] depends=["test:lume:install"]
#MISE hide=true
#USAGE arg "[hostname]" help="Temporary inventory host" default="ci-macos"
#USAGE flag "--consumer <path>" help="External consumer repository"
set -euo pipefail

framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
# shellcheck source=.mise/lib/common.sh
source "$framework_root/.mise/lib/common.sh"
# shellcheck source=.mise/lib/consumer.sh
source "$framework_root/.mise/lib/consumer.sh"
# shellcheck source=.mise/lib/consumer-integration.sh
source "$framework_root/.mise/lib/consumer-integration.sh"
# shellcheck source=.mise/lib/lume.sh
source "$framework_root/.mise/lib/lume.sh"

if [ -n "${usage_consumer:-}" ]; then
  export MAISON_CONSUMER_ROOT="$usage_consumer"
fi
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
require_command curl
require_command git
require_command jq
require_command mise
require_command python3
require_command scp
require_command ssh
require_command ssh-keygen
require_command tar

maison_ref="$(consumer_integration_maison_ref "$root")"
github_token="$(consumer_integration_require_github_token)"
bootstrap_ref="${MAISON_MACOS_BOOTSTRAP_REF:-}"
if [ -z "$bootstrap_ref" ]; then
  current_branch="$(git -C "$framework_root" branch --show-current)"
  if [ "$current_branch" = feat/test-bootstrap-macos ]; then
    bootstrap_ref="$current_branch"
  else
    bootstrap_ref="$maison_ref"
  fi
fi
bootstrap_revision="$(consumer_integration_resolve_github_ref "$bootstrap_ref" "$github_token")" ||
  die "Maison bootstrap reference is unavailable: $bootstrap_ref"
lume_binary="$(maison_lume_bin)"
[ -x "$lume_binary" ] || die "verified Lume ${MAISON_LUME_VERSION} is unavailable at $lume_binary"
"$lume_binary" --version 2>&1 | grep -Eq "(^|[^0-9])${MAISON_LUME_VERSION}([^0-9]|$)" ||
  die "Lume ${MAISON_LUME_VERSION} is required at $lume_binary"

base_name="${MAISON_MACOS_BASE_NAME:-macos-tahoe-with-nix}"
case "$base_name" in
  [A-Za-z0-9]*) ;;
  *) die "invalid local Lume base name: $base_name" ;;
esac
case "$base_name" in
  *[!A-Za-z0-9._-]*) die "invalid local Lume base name: $base_name" ;;
esac
hostname="${usage_hostname:-ci-macos}"
worker_name="maison-test-macos-$$-${RANDOM:-0}"
run_id="$$-${RANDOM:-0}"
stage_dir=""
ssh_home=""
command_log=""
log_file=""
worker_created=false
worker_running=false
base_running=false

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [ "$worker_running" = true ] && [ -n "$command_log" ]; then
    stop_lume_vm "$worker_name" || true
  fi
  if [ "$worker_created" = true ] && [ -n "$command_log" ]; then
    "$lume_binary" delete "$worker_name" --storage default --force >>"$command_log" 2>&1 || true
  fi
  if [ "$base_running" = true ] && [ -n "$command_log" ]; then
    stop_lume_vm "$base_name" || true
  fi
  github_token=""
  if [ -n "${MAISON_MAC_LOG:-}" ] && [ -n "$log_file" ] && [ -f "$log_file" ]; then
    chmod 600 "$log_file"
  fi
  [ -n "$stage_dir" ] && rm -rf "$stage_dir"
  [ -n "$ssh_home" ] && rm -rf "$ssh_home"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/maison-macos.XXXXXX")"
ssh_home="$(mktemp -d "${TMPDIR:-/tmp}/maison-macos-ssh.XXXXXX")"
chmod 700 "$stage_dir" "$ssh_home"
consumer_stage="$stage_dir/consumer"
bootstrap_file="$stage_dir/bootstrap.sh"
mise_artifact="$stage_dir/mise"
token_file="$stage_dir/.github-token"
ssh_key="$ssh_home/maison-test-ed25519"
pubkey_file="$ssh_key.pub"
base_info="$stage_dir/base.json"
worker_info="$stage_dir/worker.json"
command_log="$stage_dir/lume.log"
remote_log="$stage_dir/remote.log"
log_file="${MAISON_MAC_LOG:-$stage_dir/result.log}"
remote_root="/tmp/maison-mac-integration-$run_id"
: > "$log_file"
chmod 600 "$log_file"
record() {
  printf '%s\n' "$*" | tee -a "$log_file"
}

consumer_integration_stage "$root" "$consumer_stage" "$hostname" '["base", "linux"]'
cat >"$consumer_stage/inventory.toml" <<EOF
schema = 1

[users.tester]
username = "tester"
full_name = "macOS Integration Test User"
email = "tester@localhost"
github = "RobertDeRose"

[hosts.$hostname]
system = "aarch64-darwin"
user = "tester"
profiles = ["base", "mac"]
EOF
GIT_AUTHOR_DATE=2000-01-01T00:00:00Z \
  GIT_COMMITTER_DATE=2000-01-01T00:00:00Z \
  git -C "$consumer_stage" add inventory.toml
GIT_AUTHOR_DATE=2000-01-01T00:00:00Z \
  GIT_COMMITTER_DATE=2000-01-01T00:00:00Z \
  git -C "$consumer_stage" commit --amend --no-edit -qm 'test: stage macOS consumer fixture'

consumer_integration_fetch_bootstrap "$bootstrap_ref" "$github_token" "$bootstrap_file"
consumer_integration_fetch_framework_artifact "$framework_root" mise aarch64-darwin "$mise_artifact" ||
  die "could not fetch the verified mise artifact for worker fnox preparation"
chmod 700 "$mise_artifact"
umask 077
printf '%s\n' "$github_token" >"$token_file"
chmod 600 "$token_file"
github_token=""

ssh-keygen -q -t ed25519 -N '' -f "$ssh_key" -C maison-macos-integration
ssh_options=(
  -i "$ssh_key"
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o PreferredAuthentications=publickey
  -o PasswordAuthentication=no
  -o KbdInteractiveAuthentication=no
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o LogLevel=ERROR
  -o ConnectTimeout=5
)
scp_options=(
  -i "$ssh_key"
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o PreferredAuthentications=publickey
  -o PasswordAuthentication=no
  -o KbdInteractiveAuthentication=no
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o LogLevel=ERROR
)
ssh_target() {
  # shellcheck disable=SC2029 # validated SSH options intentionally expand locally
  ssh "${ssh_options[@]}" "$@"
}
scp_target() {
  scp "${scp_options[@]}" "$@"
}

lume_command() {
  "$lume_binary" "$@" >>"$command_log" 2>&1
}
lume_get_json() {
  local destination="$1"
  shift
  "$lume_binary" "$@" >"$destination" 2>>"$command_log"
}
lume_vm_stopped() {
  local name="$1" info
  info="$($lume_binary get "$name" --storage default --format json 2>/dev/null)" || return 1
  printf '%s' "$info" | jq -e 'if type == "array" then all(.[]; .status == "stopped") else .status == "stopped" end' >/dev/null 2>&1
}
stop_lume_vm() {
  local name="$1" attempt pid
  "$lume_binary" stop "$name" --storage default >>"$command_log" 2>&1 || true
  for attempt in $(seq 1 10); do
    lume_vm_stopped "$name" && return 0
    sleep 1
  done
  pid="$(ps -axo pid=,command= | awk -v name="$name" '$0 ~ /lume run/ && index($0, name) { print $1; exit }')"
  if [ -n "$pid" ] && [ "$pid" != "$$" ]; then
    printf '==> Forcibly stopping task-owned Lume process %s for %s\n' "$pid" "$name" >>"$command_log"
    kill "$pid" >>"$command_log" 2>&1 || true
  fi
  for attempt in $(seq 1 10); do
    lume_vm_stopped "$name" && return 0
    sleep 1
  done
  printf 'error: Lume VM %s did not stop\n' "$name" >>"$command_log"
  return 1
}
wait_for_lume_ssh() {
  local name="$1" info="$2" attempt
  for attempt in $(seq 1 180); do
    if lume_get_json "$info" get "$name" --storage default --format json &&
      jq -e 'if type == "array" then any(.[]; .sshAvailable == true) else .sshAvailable == true end' "$info" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  record "error: Lume SSH was not available for $name after $attempt attempts"
  return 1
}
wait_for_lume_nix() {
  local name="$1" attempt
  for attempt in $(seq 1 180); do
    if lume_command ssh "$name" --storage default --user lume --password lume --timeout 30 \
      'test -x /nix/var/nix/profiles/default/bin/nix && test -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh && test -S /nix/var/nix/daemon-socket/socket'; then
      return 0
    fi
    sleep 1
  done
  record "error: the Nix daemon was not ready in $name after $attempt attempts"
  return 1
}
if ! lume_get_json "$base_info" get "$base_name" --storage default --format json; then
  die "local Lume base $base_name is unavailable; create it before running the macOS bootstrap test"
fi
jq -e 'type == "object" or type == "array"' "$base_info" >/dev/null || die "Lume returned invalid base metadata"
lume_command stop "$base_name" --storage default || true
record "==> Verifying supplied local Lume VM $base_name before cloning"
base_running=true
lume_command run "$base_name" --storage default --detach --display none --log-file "$stage_dir/base-runtime.log" ||
  die "could not boot the supplied local macOS base for preflight"
wait_for_lume_ssh "$base_name" "$base_info" ||
  die "supplied local macOS base SSH did not become available"
wait_for_lume_nix "$base_name" ||
  die "supplied local macOS base Nix daemon did not become ready"
# shellcheck disable=SC2016 # the command is evaluated inside the guest
if ! lume_command ssh "$base_name" --storage default --user lume --password lume --timeout 180 \
  'set -e; test "$(sw_vers -productVersion)" = "26.6.1"; test "$(sw_vers -buildVersion)" = "25G76"; command -v xcode-select >/dev/null; test -x /nix/var/nix/profiles/default/bin/nix; test -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh; test -S /nix/var/nix/daemon-socket/socket; test -r /etc/ssh/sshd_config; test "$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)" = "lume"; csrutil status | grep -Eiq "enabled"; test "$(id -un)" = "lume"' \
  >"$remote_log"; then
  die "supplied local macOS base failed identity, SSH, unattended-login, or SIP preflight"
fi
lume_command stop "$base_name" --storage default || die "could not stop the supplied local macOS base after preflight"
base_running=false

record "==> Cloning disposable macOS worker $worker_name from $base_name"
worker_created=true
lume_command clone "$base_name" "$worker_name" --source-storage default --dest-storage default || die "could not clone the supplied local macOS base"
worker_running=true
lume_command run "$worker_name" --storage default --detach --display none --log-file "$stage_dir/worker-runtime.log" ||
  die "could not boot disposable macOS worker"
wait_for_lume_ssh "$worker_name" "$worker_info" ||
  die "disposable macOS worker SSH did not become available"
wait_for_lume_nix "$worker_name" ||
  die "disposable macOS worker Nix daemon did not become ready"
jq -e 'type == "object" or type == "array"' "$worker_info" >/dev/null || die "Lume returned invalid worker metadata"

record "==> Preparing disposable macOS worker privilege for the pinned bootstrap"
worker_prep_script="$(cat <<'REMOTE_WORKER_PREPARE'
set -euo pipefail
sudo_password=lume
sudo_run() {
  printf '%s\n' "$sudo_password" | sudo -S -p '' "$@"
}
if ! sudo -n true >/dev/null 2>&1; then
  sudoers_file=/tmp/maison-lume-sudoers
  cat >"$sudoers_file" <<'EOF'
lume ALL=(ALL) NOPASSWD: ALL
tester ALL=(ALL) NOPASSWD: ALL
EOF
  sudo_run install -o root -g wheel -m 440 "$sudoers_file" /etc/sudoers.d/lume
  rm -f "$sudoers_file"
  sudo_run visudo -cf /etc/sudoers
fi
sudo -n true
if ! xcode-select -p >/dev/null 2>&1; then
  marker=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  sudo_run touch "$marker"
  trap 'sudo_run rm -f "$marker" 2>/dev/null || true' EXIT
  product="$(softwareupdate -l 2>/dev/null | awk -F': ' '/^\* Label: Command Line Tools for Xcode / { value=$2 } END { print value }')"
  [ -n "$product" ] || { printf '%s\n' 'no Command Line Tools update was found' >&2; exit 1; }
  printf '%s\n' "$sudo_password" | sudo -n softwareupdate -i "$product" --user lume --stdinpass --verbose
  sudo_run xcode-select --switch /Library/Developer/CommandLineTools
  sudo_run rm -f "$marker"
  trap - EXIT
fi
test -d /Library/Developer/CommandLineTools
test -n "$(xcode-select -p)"
if ! id -u tester >/dev/null 2>&1; then
  sudo_run sysadminctl -addUser tester -fullName 'Maison Integration Test User' \
    -home /Users/tester -shell /bin/zsh -password MaisonTestOnly2026
fi
test "$(id -u tester)" -gt 0
sudo_run mkdir -p /Users/tester
sudo_run chown tester:staff /Users/tester
sudo_run chmod 700 /Users/tester
sudo -n true
REMOTE_WORKER_PREPARE
)"
if ! lume_command ssh "$worker_name" --storage default --user lume --password lume --timeout 1800 "$worker_prep_script"; then
  die "could not prepare disposable macOS worker privilege"
fi

worker_ip="$(python3 - "$worker_info" <<'PY'
import ipaddress
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle)


def values(item):
    if isinstance(item, dict):
        for child in item.values():
            yield from values(child)
    elif isinstance(item, list):
        for child in item:
            yield from values(child)
    elif isinstance(item, str):
        yield item

for candidate in values(value):
    try:
        address = ipaddress.ip_address(candidate)
    except ValueError:
        continue
    if address.version == 4 and not (address.is_loopback or address.is_unspecified or address.is_multicast):
        print(address)
        break
else:
    raise SystemExit("Lume metadata did not contain a usable worker IPv4 address")
PY
)"
python3 - "$worker_ip" <<'PY'
import ipaddress
import sys

address = ipaddress.ip_address(sys.argv[1])
if address.version != 4 or address.is_loopback or address.is_unspecified or address.is_multicast:
    raise SystemExit(f"invalid disposable worker address: {address}")
PY

record "==> Installing only the generated public SSH key through the disposable Lume account"
pubkey="$(cat "$pubkey_file")"
printf -v quoted_pubkey '%q' "$pubkey"
lume_command ssh "$worker_name" --storage default --user lume --password lume --timeout 180 \
  "umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys; printf '%s\\n' $quoted_pubkey >> ~/.ssh/authorized_keys; chmod 700 ~/.ssh; chmod 600 ~/.ssh/authorized_keys" \
  || die "could not install the disposable public SSH key"

wait_for_ssh() {
  local target="$1" attempt
  for attempt in $(seq 1 120); do
    if ssh_target -T "$target" true >>"$remote_log" 2>&1; then
      return 0
    fi
    sleep 1
  done
  record "error: disposable macOS worker SSH did not become ready after $attempt attempts"
  return 1
}
wait_for_ssh "lume@$worker_ip" || die "disposable macOS worker SSH is unavailable"

ssh_target "lume@$worker_ip" /bin/bash -s -- "$remote_root" <<'REMOTE_PREPARE' >>"$remote_log" 2>&1
set -euo pipefail
remote_root="$1"
mkdir -p "$remote_root"
chmod 700 "$remote_root"
REMOTE_PREPARE
scp_target -r "$consumer_stage" "lume@$worker_ip:$remote_root/" >>"$remote_log" 2>&1 || die "could not transfer committed consumer stage"
scp_target "$bootstrap_file" "$token_file" "$mise_artifact" "lume@$worker_ip:$remote_root/" >>"$remote_log" 2>&1 ||
  die "could not transfer validated bootstrap inputs"
ssh_target "lume@$worker_ip" /bin/bash -s -- "$remote_root" <<'REMOTE_PERMISSIONS' >>"$remote_log" 2>&1
set -euo pipefail
remote_root="$1"
chmod 700 "$remote_root"
chmod 700 "$remote_root/consumer"
chmod 700 "$remote_root/bootstrap.sh" "$remote_root/.github-token"
chmod 700 "$remote_root/mise"
REMOTE_PERMISSIONS

record "==> Installing consumer fnox prerequisite"
if ! ssh_target "lume@$worker_ip" /bin/bash -s -- "$remote_root" <<'REMOTE_RUNTIME_PREP' >>"$remote_log" 2>&1
set -euo pipefail
remote_root="$1"
mise_bin=/Users/lume/.local/bin/mise
mkdir -p /Users/lume/.local/bin
chmod 700 /Users/lume/.local/bin
install -m 0755 "$remote_root/mise" "$mise_bin"
rm -f "$remote_root/mise"
"$mise_bin" trust "$remote_root/consumer/mise.toml" >/dev/null
MISE_GLOBAL_CONFIG_FILE="$remote_root/consumer/config/mise/config.toml" \
  "$mise_bin" -C "$remote_root/consumer" install fnox
fnox_bin="$(MISE_GLOBAL_CONFIG_FILE="$remote_root/consumer/config/mise/config.toml" \
  "$mise_bin" -C "$remote_root/consumer" which fnox)"
[ -x "$fnox_bin" ]
ln -sfn "$fnox_bin" /Users/lume/.local/bin/fnox
test -x /Users/lume/.local/bin/fnox
REMOTE_RUNTIME_PREP
then
  die "could not install the consumer fnox prerequisite"
fi

record "==> Running Maison bootstrap ref $bootstrap_ref inside disposable worker $worker_name"
if ! ssh_target "lume@$worker_ip" /bin/bash -s -- "$remote_root" "$hostname" "$bootstrap_ref" <<'REMOTE_BOOTSTRAP' >"$remote_log" 2>&1
set -euo pipefail
remote_root="$1"
hostname="$2"
bootstrap_ref="$3"
trap 'rm -f "$remote_root/.github-token" "$remote_root/bootstrap.sh"' EXIT
github_token="$(cat "$remote_root/.github-token")"
export GITHUB_TOKEN="$github_token"
unset github_token
unset LC_ALL
export LANG=C.UTF-8
export LC_CTYPE=C.UTF-8
export HOME_MANAGER_USER=tester
export NIX_BUILD_CORES=1
export CARGO_BUILD_JOBS=1
nix_bash="$(find /nix/store -maxdepth 3 -path '*/bin/bash' -type f -perm -111 -print -quit)"
[ -n "$nix_bash" ] || { printf '%s\n' 'Nix Bash is unavailable in the prepared worker' >&2; exit 1; }
export PATH="$(dirname "$nix_bash"):$PATH"
export NIX_INSTALLER_NO_SANDBOX=true
export NIX_CONFIG="${NIX_CONFIG:-}
experimental-features = nix-command flakes"
export MISE_TASK_RUN_AUTO_INSTALL=false
MAISON_FNOX_PREFLIGHT_DONE=true bash "$remote_root/bootstrap.sh" \
  --host "$hostname" \
  --consumer "$remote_root/consumer" \
  --repo RobertDeRose/maison \
  --ref "$bootstrap_ref"
unset MAISON_FNOX_PREFLIGHT_DONE
bash "$remote_root/bootstrap.sh" \
  --host "$hostname" \
  --consumer "$remote_root/consumer" \
  --repo RobertDeRose/maison \
  --ref "$bootstrap_ref"
unset GITHUB_TOKEN
REMOTE_BOOTSTRAP
then
  die "Maison bootstrap failed inside disposable macOS worker"
fi

# The worker preflight creates the staged test user before system activation. Run the user layer
# once as that user so the verification covers the configured consumer identity,
# not only the disposable Lume administrator used for first access.
record "==> Converging the staged test user's mise/fnox state"
if ! ssh_target "lume@$worker_ip" /bin/bash -s -- "$remote_root" >"$remote_log" 2>&1 <<'REMOTE_USER'
set -euo pipefail
remote_root="$1"
maison_root=/Users/lume/.maison
mise_bin=/Users/lume/.local/bin/mise
nix_bash="$(find /nix/store -maxdepth 3 -path '*/bin/bash' -type f -perm -111 -print -quit)"
[ -n "$nix_bash" ] || { printf '%s\n' 'Nix Bash is unavailable in the prepared worker' >&2; exit 1; }
nix_bash_dir="$(dirname "$nix_bash")"
sudo -n chown -R tester:staff "$remote_root/consumer"
sudo -n chmod 755 "$remote_root" "$remote_root/consumer"
sudo -n -u tester env HOME=/Users/tester PATH="$nix_bash_dir:/Users/lume/.local/bin:/Users/tester/.local/bin:/usr/bin:/bin" \
  MISE_GLOBAL_CONFIG_FILE="$remote_root/consumer/config/mise/config.toml" \
  "$mise_bin" -C "$remote_root/consumer" install fnox
fnox_bin="$(sudo -n -u tester env HOME=/Users/tester PATH="$nix_bash_dir:/Users/lume/.local/bin:/Users/tester/.local/bin:/usr/bin:/bin" \
  MISE_GLOBAL_CONFIG_FILE="$remote_root/consumer/config/mise/config.toml" \
  "$mise_bin" -C "$remote_root/consumer" which fnox)"
sudo -n -u tester mkdir -p /Users/tester/.local/bin
sudo -n -u tester ln -sfn "$fnox_bin" /Users/tester/.local/bin/fnox
sudo -n -u tester env HOME=/Users/tester PATH="$nix_bash_dir:/Users/lume/.local/bin:/Users/tester/.local/bin:/usr/bin:/bin" \
  MAISON_HOME="$maison_root" \\
  MAISON_CONSUMER_ROOT="$remote_root/consumer" \
  MISE_TRUSTED_CONFIG_PATHS="$maison_root" \
  MAISON_FNOX_PREFLIGHT_DONE=true \
  MISE_TASK_RUN_AUTO_INSTALL=false \
  "$mise_bin" -C "$maison_root" run user:apply
REMOTE_USER
then
  die "staged macOS test-user convergence failed"
fi

record "==> Verifying macOS identity and bootstrap convergence"
if ! ssh_target "lume@$worker_ip" /bin/bash -s -- "$hostname" "$bootstrap_revision" "$remote_root" <<'REMOTE_VERIFY' >"$remote_log" 2>&1
set -euo pipefail
expected_hostname="$1"
expected_revision="$2"
remote_root="$3"
test "$(sw_vers -productVersion)" = "26.6.1"
test "$(sw_vers -buildVersion)" = "25G76"
test -d /Library/Developer/CommandLineTools
test -r /etc/ssh/sshd_config
csrutil status | grep -Eiq "enabled"
test "$(hostname -s)" = "$expected_hostname"
test -d /Users/tester
test -f /Users/lume/.maison/flake.nix
test "$(git -C /Users/lume/.maison rev-parse HEAD)" = "$expected_revision"
test -x /Users/lume/.local/bin/mise
test -x /Users/lume/.local/bin/fnox
test -x /Users/lume/.local/bin/maison
test -x /Users/tester/.local/bin/fnox
test -f /Users/tester/.config/mise/config.toml || test -L /Users/tester/.config/mise/config.toml
test "$(locale -a | grep -Fx 'C.UTF-8')" = "C.UTF-8"
test "$(env -i LANG=C.UTF-8 LC_CTYPE=C.UTF-8 PATH=/usr/bin:/bin /usr/bin/locale charmap)" = "UTF-8"
test ! -e "$HOME/.ssh/maison-test-ed25519"
test ! -e "$remote_root/.github-token"
test ! -e "$remote_root/bootstrap.sh"
REMOTE_VERIFY
then
  die "macOS bootstrap convergence or disposable worker identity verification failed"
fi
ssh_target "lume@$worker_ip" /bin/bash -s -- "$remote_root" >>"$remote_log" 2>&1 <<'REMOTE_CLEANUP'
set -euo pipefail
rm -rf "$1"
REMOTE_CLEANUP

record "macOS bootstrap completed: supplied Tahoe 26.6.1/build 25G76, Command Line Tools, SSH, SIP-enabled base, Darwin/system convergence, user convergence, Maison ref $bootstrap_ref, UTF-8 locale, and worker identity verified."
