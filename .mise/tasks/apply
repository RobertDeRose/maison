#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Apply the Nix system layer, then converge the mise user layer"
# [MISE] interactive=true
#USAGE flag "--host <host>" help="Inventory host"
#USAGE flag "--system-only" help="Skip the mise user layer"
#USAGE flag "--user-only" help="Skip the Nix system layer"
#USAGE flag "--force-dotfiles" help="Replace conflicting user dotfiles"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
# shellcheck source=.mise/lib/fnox.sh
source "$framework_root/.mise/lib/fnox.sh"
maison_fnox_preflight "$root"
if [ "${usage_system_only:-false}" = true ] && [ "${usage_user_only:-false}" = true ]; then
  printf 'error: --system-only and --user-only are mutually exclusive\n' >&2
  exit 2
fi
if [ "${usage_user_only:-false}" != true ]; then
  args=()
  [ -z "${usage_host:-}" ] || args+=(--host "$usage_host")
  mise -C "$framework_root" run system:apply -- "${args[@]}"
fi
if [ "${usage_system_only:-false}" != true ]; then
  args=()
  [ "${usage_force_dotfiles:-false}" != true ] || args+=(--force-dotfiles)
  mise -C "$framework_root" run user:apply -- "${args[@]}"
fi
