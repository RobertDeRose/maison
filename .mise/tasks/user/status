#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Show drift in the mise-managed user environment"
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
source "$root/.mise/lib/overlay.sh"
load_maison_overlay_environment "$root"
exec python3 "$root/.mise/lib/user_convergence.py" status --root "$root"
