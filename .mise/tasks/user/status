#!/usr/bin/env bash
# [MISE] description="Show drift in the mise-managed user environment"
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
cd "$root"
mise bootstrap dotfiles status
if [ -f "$HOME/.config/mise/config.toml" ]; then
  (cd "$HOME"; MISE_AUTO_ENV=true MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/config.toml" mise bootstrap status)
fi
