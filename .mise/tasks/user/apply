#!/usr/bin/env bash
# [MISE] description="Converge user tools, applications, preferences, and dotfiles with mise"
# [MISE] interactive=true
#USAGE flag "--force-dotfiles" help="Replace conflicting whole-file targets"
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
source "$root/.mise/lib/overlay.sh"
load_maison_overlay_environment "$root"
args=()
[ "${usage_force_dotfiles:-false}" != true ] || args+=(--force-dotfiles)
exec python3 "$root/.mise/lib/user_convergence.py" apply --root "$root" "${args[@]}"
