#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Upgrade mise-managed user tools"
# [MISE] interactive=true
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
source "$framework_root/.mise/lib/consumer.sh"
load_maison_consumer_environment "$root"
config_root="${MAISON_USER_CONFIG_ROOT:-$root}"
config="$config_root/config/mise/config.toml"
(
  cd "$HOME"
  MISE_AUTO_ENV=true MISE_GLOBAL_CONFIG_FILE="$config" mise outdated || true
  MISE_AUTO_ENV=true MISE_GLOBAL_CONFIG_FILE="$config" mise upgrade
)
