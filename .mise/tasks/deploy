#!/usr/bin/env bash
# [MISE] quiet=true
# [MISE] description="Deploy Linux system state, then transactionally converge its mise user environment"
# [MISE] interactive=true
#USAGE arg "<host>" help="Linux inventory host"
#USAGE flag "--system-only" help="Skip repository transfer and remote user bootstrap"
#USAGE flag "--force-dotfiles" help="Replace conflicting remote user dotfiles"
set -euo pipefail
framework_root="${MAISON_HOME:-${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}}"
source "$framework_root/.mise/lib/common.sh"
root="$(maison_consumer_root "${BASH_SOURCE[0]}")"
# shellcheck source=.mise/lib/fnox.sh
source "$framework_root/.mise/lib/fnox.sh"
maison_fnox_preflight "$root"
cd "$root"
source "$framework_root/.mise/lib/inventory.sh"

host="${usage_host:?mise did not provide the required host argument}"
require_inventory_host "$root" "$host"
[ "$(host_platform_class "$root" "$host")" = linux ] || die "deploy supports Linux inventory hosts only"

archive=""
remote_archive=""
remote_helper=""
remote_framework_root=""
hostname=""
ssh_user=""
user=""
cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  [ -z "$archive" ] || rm -f "$archive"
  cleanup_paths=()
  [ -z "$remote_archive" ] || cleanup_paths+=("$remote_archive")
  if [ -n "$remote_framework_root" ] && [ -n "$hostname" ] && [ -n "$user" ]; then
    quoted_framework_root="$(printf '%q' "$remote_framework_root")"
    # shellcheck disable=SC2029 # validated mktemp paths are shell-escaped above
    ssh "$user@$hostname" "rm -rf -- $quoted_framework_root" > /dev/null 2>&1 || true
  fi
  if [ "${#cleanup_paths[@]}" -gt 0 ] && [ -n "$hostname" ] && [ -n "$ssh_user" ]; then
    quoted_cleanup=""
    for cleanup_path in "${cleanup_paths[@]}"; do
      quoted_cleanup+=" $(printf '%q' "$cleanup_path")"
    done
    # shellcheck disable=SC2029 # validated mktemp paths are shell-escaped above
    ssh "$ssh_user@$hostname" "rm -f -- $quoted_cleanup" > /dev/null 2>&1 || true
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "${usage_system_only:-false}" != true ]; then
  archive="$(mktemp "${TMPDIR:-/tmp}/maison-deploy.XXXXXX.tar.gz")"
  "$framework_root/scripts/create-deploy-archive.sh" "$root" "$archive"
fi

mise -C "$framework_root" run system:deploy -- "$host"
[ "${usage_system_only:-false}" != true ] || exit 0

hostname="$(inventory_deploy_hostname "$root" "$host")"
ssh_user="$(inventory_deploy_ssh_user "$root" "$host")"
user="$(inventory_deploy_user_ssh_user "$root" "$host")"
repo_path="$(inventory_deploy_repo_path "$root" "$host")"
remote_archive="$(ssh "$ssh_user@$hostname" 'umask 077; mktemp /tmp/maison-deploy.XXXXXX.tar.gz')"
[[ $remote_archive =~ ^/tmp/maison-deploy\.[A-Za-z0-9]+\.tar\.gz$ ]] ||
  die "remote mktemp returned an unsafe archive path: $remote_archive"
remote_helper="/etc/maison/maison-deploy-transaction"
remote_framework_root="$(ssh "$user@$hostname" 'umask 077; mktemp -d /tmp/maison-runtime.XXXXXX')"
[[ $remote_framework_root =~ ^/tmp/maison-runtime\.[A-Za-z0-9]+$ ]] ||
  die "remote mktemp returned an unsafe Maison runtime path: $remote_framework_root"
quoted_archive="$(printf '%q' "$remote_archive")"
quoted_helper="$(printf '%q' "$remote_helper")"
quoted_framework_root="$(printf '%q' "$remote_framework_root")"
# shellcheck disable=SC2029 # destinations are shell-escaped above
ssh "$ssh_user@$hostname" "cat > $quoted_archive" < "$archive"
# shellcheck disable=SC2029 # the runtime path is validated and shell-escaped above
ssh "$user@$hostname" "mkdir -p $quoted_framework_root/.mise/lib $quoted_framework_root/scripts $quoted_framework_root/bin $quoted_framework_root/dotfiles/pi $quoted_framework_root/bootstrap $quoted_framework_root/config/mise $quoted_framework_root/schemas"
runtime_files=(
  .mise/lib/common.sh
  .mise/lib/platform.sh
  .mise/lib/bootstrap.sh
  .mise/lib/dotfile_backups.py
  .mise/lib/user_convergence.py
  .mise/lib/fnox.py
  .mise/lib/fnox.sh
  scripts/user-prepare.sh
  scripts/user-link-mise-lock.sh
  scripts/user-apply-packages.sh
  scripts/user-finalize.sh
  mise.toml
  mise.lock
  bin/maison
  dotfiles/pi/settings.defaults.json
  bootstrap/artifacts.toml
  schemas/fnox.toml
  config/mise/config.toml
  config/mise/config.macos.toml
  config/mise/config.macos-arm64.toml
  config/mise/config.linux.toml
  config/mise/mise.lock
  config/mise/config.macos.lock
)
for runtime_file in "${runtime_files[@]}"; do
  quoted_runtime_file="$(printf '%q' "$remote_framework_root/$runtime_file")"
  # shellcheck disable=SC2029 # the runtime path is validated and shell-escaped above
  ssh "$user@$hostname" "cat > $quoted_runtime_file" < "$framework_root/$runtime_file"
done
# shellcheck disable=SC2029 # paths are validated and shell-escaped above
ssh "$user@$hostname" "chmod 0644 $quoted_framework_root/.mise/lib/user_convergence.py $quoted_framework_root/.mise/lib/fnox.py; chmod 0755 $quoted_framework_root/.mise/lib/fnox.sh $quoted_framework_root/scripts/user-prepare.sh $quoted_framework_root/scripts/user-link-mise-lock.sh $quoted_framework_root/scripts/user-apply-packages.sh $quoted_framework_root/scripts/user-finalize.sh $quoted_framework_root/bin/maison"

quoted_repo="$(printf '%q' "$repo_path")"
sudo_prefix=""
if [ "$ssh_user" != root ]; then
  sudo_prefix="sudo "
fi
# shellcheck disable=SC2029 # argument escaping handled above
if ! ssh "$ssh_user@$hostname" "${sudo_prefix}$quoted_helper recover"; then
  printf 'error: existing transaction state recovery failed for %s\n' "$repo_path" >&2
  exit 1
fi

quoted_remote_archive="$(printf '%q' "$remote_archive")"
# shellcheck disable=SC2029 # all arguments are shell-escaped above
ssh "$ssh_user@$hostname" \
  "${sudo_prefix}$quoted_helper stage $quoted_remote_archive"
# The staging helper removes the remote archive after extracting it. Avoid a
# second SSH cleanup attempt on every successful deployment.
remote_archive=""
# shellcheck disable=SC2029 # validated repository path is intentionally expanded on the client
failed_revision="$(ssh "$user@$hostname" "cat -- $quoted_repo/.maison-revision")"
[[ $failed_revision =~ ^[0-9a-f]{40}$ ]] || die "staged repository has an invalid revision: $failed_revision"
quoted_failed_revision="$(printf '%q' "$failed_revision")"

remote_args=()
[ "${usage_force_dotfiles:-false}" != true ] || remote_args+=(--force-dotfiles)
quoted_user_args=""
for arg in "${remote_args[@]}"; do
  quoted_user_args+=" $(printf '%q' "$arg")"
done
quoted_args=" $quoted_failed_revision $quoted_framework_root$quoted_user_args"
# shellcheck disable=SC2029 # repository, runtime, and optional arguments are shell-escaped
if ssh "$user@$hostname" "bash -s -- $quoted_repo$quoted_args" << 'REMOTE_USER'; then
set -eu
repo_path="$1"
failed_revision="$2"
runtime_root="$3"
shift 3
export MAISON_HOME="$runtime_root"
export MAISON_CONSUMER_ROOT="$repo_path"
# shellcheck source=.mise/lib/fnox.sh
. "$runtime_root/.mise/lib/fnox.sh"
if ! command -v mise >/dev/null 2>&1; then
  # shellcheck source=.mise/lib/common.sh
  . "$runtime_root/.mise/lib/common.sh"
  # shellcheck source=.mise/lib/platform.sh
  . "$runtime_root/.mise/lib/platform.sh"
  # shellcheck source=.mise/lib/bootstrap.sh
  . "$runtime_root/.mise/lib/bootstrap.sh"
  export MISE_PROJECT_ROOT="$runtime_root"
  install_mise_if_missing
  unset MISE_PROJECT_ROOT
fi
cd "$repo_path"
export MISE_TRUSTED_CONFIG_PATHS="$repo_path${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
recovery_dir="$HOME/.local/state/maison/recovery"
phase_file="$recovery_dir/.remote-convergence-$failed_revision.events.json"
report_file="$recovery_dir/remote-convergence-$failed_revision.json"
mkdir -p -m 700 "$recovery_dir"
rm -f -- "$phase_file" "$report_file"
export MAISON_CONVERGENCE_EVENT_FILE="$phase_file"
mise trust "$runtime_root/mise.toml" >/dev/null
if maison_fnox_config_path "$repo_path" >/dev/null 2>&1; then
  maison_fnox_preflight "$repo_path"
  maison_fnox_exec "$repo_path" "$runtime_root/.mise/lib/user_convergence.py" apply --root "$repo_path" "$@"
else
  "$runtime_root/.mise/lib/user_convergence.py" apply --root "$repo_path" "$@"
fi
rm -f -- "$phase_file"
REMOTE_USER
  action=commit
  user_status=0
else
  action=rollback
  user_status=$?
fi

quoted_action="$(printf '%q' "$action")"
# shellcheck disable=SC2029 # all arguments are shell-escaped above
if ! ssh "$ssh_user@$hostname" \
  "${sudo_prefix}$quoted_helper finalize $quoted_action"; then
  if [ "$action" = rollback ]; then
    printf 'error: remote user convergence failed and repository rollback also failed; inspect the root-owned Maison transaction state for %s\n' "$repo_path" >&2
  else
    printf 'error: remote convergence succeeded but repository transaction cleanup failed; the previous repository remains recoverable\n' >&2
  fi
  exit 1
fi

if [ "$user_status" -ne 0 ]; then
  # shellcheck disable=SC2029 # validated repository path is intentionally expanded on the client
  restored_revision="$(ssh "$user@$hostname" "cat -- $quoted_repo/.maison-revision" 2> /dev/null || true)"
  [[ $restored_revision =~ ^[0-9a-f]{40}$ ]] || {
    printf 'error: remote user convergence failed and no verified prior repository is available for recovery\n' >&2
    exit "$user_status"
  }
  quoted_restored_revision="$(printf '%q' "$restored_revision")"
  quoted_initial_exit_code="$(printf '%q' "$user_status")"
  # shellcheck disable=SC2029 # repository, runtime, and recovery arguments are shell-escaped above
  if ! ssh "$user@$hostname" \
    "bash -s -- $quoted_repo $quoted_failed_revision $quoted_restored_revision $quoted_initial_exit_code $quoted_framework_root$quoted_user_args" << 'REMOTE_RECOVERY'; then
set -eu
repo_path="$1"
failed_revision="$2"
restored_revision="$3"
initial_exit_code="$4"
runtime_root="$5"
shift 5
export MAISON_HOME="$runtime_root"
export MAISON_CONSUMER_ROOT="$repo_path"
# shellcheck source=.mise/lib/fnox.sh
. "$runtime_root/.mise/lib/fnox.sh"
recovery_python="$runtime_root/.mise/lib/user_convergence.py"
recovery_prepare="$runtime_root/scripts/user-prepare.sh"
actual_restored_revision="$(cat -- "$repo_path/.maison-revision")"
[ "$actual_restored_revision" = "$restored_revision" ] || {
  printf 'error: restored repository revision changed before restricted recovery\n' >&2
  exit 1
}
recovery_dir="$HOME/.local/state/maison/recovery"
phase_file="$recovery_dir/.remote-convergence-$failed_revision.events.json"
report_file="$recovery_dir/remote-convergence-$failed_revision.json"
export MAISON_CONVERGENCE_EVENT_FILE="$phase_file"
export MAISON_RECOVERY_REPORT="$report_file"
export MAISON_RECOVERY_FAILED_REVISION="$failed_revision"
export MAISON_RECOVERY_RESTORED_REVISION="$restored_revision"
export MAISON_RECOVERY_INITIAL_EXIT_CODE="$initial_exit_code"
export MAISON_RECOVERY_PREPARE_SCRIPT="$recovery_prepare"
cd "$repo_path"
export MISE_TRUSTED_CONFIG_PATHS="$repo_path${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
if maison_fnox_config_path "$repo_path" >/dev/null 2>&1; then
  maison_fnox_preflight "$repo_path"
  maison_fnox_exec "$repo_path" python3 "$recovery_python" recovery --root "$repo_path" --report "$report_file" \
    --failed-revision "$failed_revision" --restored-revision "$restored_revision" \
    --initial-exit-code "$initial_exit_code" --event-file "$phase_file" "$@"
else
  python3 "$recovery_python" recovery --root "$repo_path" --report "$report_file" \
    --failed-revision "$failed_revision" --restored-revision "$restored_revision" \
    --initial-exit-code "$initial_exit_code" --event-file "$phase_file" "$@"
fi
REMOTE_RECOVERY
    recovery_status=0
  else
    recovery_status=$?
    printf 'error: restricted remote recovery failed; inspect the reported recovery artifact\n' >&2
  fi
  if [ "$recovery_status" -ne 0 ]; then
    printf 'error: remote user convergence failed; the previous repository was restored but recovery also failed\n' >&2
  else
    printf 'error: remote user convergence failed; the previous repository was restored and restricted recovery completed\n' >&2
  fi
  exit "$user_status"
fi
